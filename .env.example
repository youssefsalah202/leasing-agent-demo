# Required for the live agent — Claude does the actual reasoning/generation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Local storage paths (defaults below are fine for the demo)
CRM_STORE_PATH=data/crm_store.json
CONVERSATIONS_DIR=data/conversations
CHROMA_PERSIST_DIR=data/chroma

# Phase 2 — nightly batch jobs
TRIAGE_STORE_DIR=data/triage
BATCH_STATE_PATH=data/batch_state.json
STUB_CALLS_PATH=data/stub_calls.json
FOLLOW_UP_AFTER_HOURS=48

# CRM: "stub" (local JSON file) or "monday" (real board — run
# scripts/setup_monday_board.py to create it and get the board id).
CRM_BACKEND=stub
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

# Quo is still stubbed — not needed until we wire up the real API.
QUO_API_KEY=
QUO_WEBHOOK_SECRET=
